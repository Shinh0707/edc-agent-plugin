# Optional. Normally you just run `node mcp/launcher.mjs login` (Google login, saved to ~/.config/edc/auth.json).
# To use a file here instead, copy this to .env (git-ignored, excluded from the distributed zip).
# Real environment variables take precedence over files.

# API key issued by the administrator (sent as "Authorization: Bearer <key>")
# EDC_API_KEY=edc_sk_...

# Override the endpoint (default: mcp/defaults.json)
# EDC_BASE_URL=https://entertainment-design-catalog.web.app

# Service account (only when calling from inside GCP; used when EDC_API_KEY is empty)
# EDC_SERVICE_ACCOUNT_KEY=~/.config/gcp/edc-sa.json
